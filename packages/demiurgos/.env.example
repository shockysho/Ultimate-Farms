# Demiurgos Configuration

# Anthropic API (Tier 2-4)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (Tier 2-3, optional)
OPENAI_API_KEY=sk-...

# Ollama (Tier 1, local)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB (vector cache)
CHROMA_URL=http://localhost:8000

# Dashboard
DASHBOARD_PORT=3000

# API Server
API_PORT=3001

# Cost tracking
DAILY_BUDGET_USD=5.00
MONTHLY_BUDGET_USD=50.00

# Confidence thresholds
MIN_EVALUATOR_CONFIDENCE=0.7
CACHE_EXACT_THRESHOLD=0.92
CACHE_ADAPT_THRESHOLD=0.85

# Embedding Server (sentence-transformers on GPU)
EMBEDDING_URL=http://localhost:8080

# Whisper Transcription Server (for YouTube ingestion)
WHISPER_URL=http://localhost:8081

# API Authentication
DEMIURGOS_API_KEY=

# Rate Limiting (requests per minute)
API_RATE_LIMIT=100
